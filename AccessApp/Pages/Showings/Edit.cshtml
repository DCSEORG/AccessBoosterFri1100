@page "{id:int}"
@model AccessApp.Pages.Showings.EditModel
@{
    ViewData["Title"] = "Edit Showing";
}

<div class="page-header">
    <h1>Edit Showing</h1>
    <a href="/Showings" class="btn">← Back</a>
</div>

<form method="post" class="gh-form">
    <input type="hidden" asp-for="ShowingId" />
    <div class="gh-form-group">
        <label asp-for="FilmId">Film</label>
        <select asp-for="FilmId" asp-items="Model.FilmOptions" required></select>
    </div>
    <div class="gh-form-group">
        <label asp-for="ShowingDate">Date</label>
        <input asp-for="ShowingDate" type="date" required />
    </div>
    <div class="gh-form-group">
        <label asp-for="ShowingTime">Time</label>
        <input asp-for="ShowingTime" type="time" required />
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

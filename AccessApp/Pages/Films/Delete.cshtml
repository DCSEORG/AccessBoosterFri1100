@page "{id:int}"
@model AccessApp.Pages.Films.DeleteModel
@{
    ViewData["Title"] = "Delete Film";
}

<div class="page-header">
    <h1>Delete Film</h1>
    <a href="/Films" class="btn">← Back</a>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete <strong>@Model.FilmTitle</strong>?
</div>

<form method="post">
    <input type="hidden" asp-for="FilmId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="/Films" class="btn">Cancel</a>
</form>

@page
@model AccessApp.Pages.Films.CreateModel
@{
    ViewData["Title"] = "Add Film";
}

<div class="page-header">
    <h1>Add Film</h1>
    <a href="/Films" class="btn">← Back</a>
</div>

<form method="post" class="gh-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
    <div class="gh-form-group">
        <label asp-for="FilmTitle">Film Title</label>
        <input asp-for="FilmTitle" required maxlength="50" />
    </div>
    <button type="submit" class="btn btn-primary">Save Film</button>
</form>

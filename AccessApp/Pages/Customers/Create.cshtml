@page
@model AccessApp.Pages.Customers.CreateModel
@{
    ViewData["Title"] = "Add Customer";
}

<div class="page-header">
    <h1>Add Customer</h1>
    <a href="/Customers" class="btn">← Back</a>
</div>

<form method="post" class="gh-form">
    <div class="gh-form-group">
        <label asp-for="CustName">Customer Name</label>
        <input asp-for="CustName" required maxlength="50" />
    </div>
    <button type="submit" class="btn btn-primary">Save Customer</button>
</form>
